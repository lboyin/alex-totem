/*
 * TOTEM keymap — QWERTY base, modular bsag/urob-style structure.
 *
 *  - Home-row mods on both hands (Ctrl/Alt/GUI/Shift, balanced flavor with
 *    require-prior-idle-ms so they don't trigger while you're typing fast).
 *  - 5 layers: BASE, NAV, NUM, FUN, UTIL — thumb layer-taps switch them.
 *  - Combos for shift-symbols, brackets/parens/braces, cut/copy/paste,
 *    and caps-word (see combos.dtsi).
 *  - mod-morphs: `,`->`;`, `.`->`:`.
 *
 * Position numbering is row-major (matches Studio's expectations):
 *
 *      LT4 LT3 LT2 LT1 LT0     RT0 RT1 RT2 RT3 RT4    <- 0..9
 *      LM4 LM3 LM2 LM1 LM0     RM0 RM1 RM2 RM3 RM4    <- 10..19
 *  LB5 LB4 LB3 LB2 LB1 LB0     RB0 RB1 RB2 RB3 RB4 RB5  <- LB4..LB0 = 20..24, RB0..RB4 = 25..29, LB5=30, RB5=37
 *          LH2 LH1 LH0         RH0 RH1 RH2            <- LH2/1/0 = 31..33, RH0/1/2 = 34..36
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <zmk-helpers/helper.h>

/* --------------------- position labels (row-major) --------------------- */
// Top row
#define LT4 0
#define LT3 1
#define LT2 2
#define LT1 3
#define LT0 4
#define RT0 5
#define RT1 6
#define RT2 7
#define RT3 8
#define RT4 9

// Home row
#define LM4 10
#define LM3 11
#define LM2 12
#define LM1 13
#define LM0 14
#define RM0 15
#define RM1 16
#define RM2 17
#define RM3 18
#define RM4 19

// Inner bottom row
#define LB4 20
#define LB3 21
#define LB2 22
#define LB1 23
#define LB0 24
#define RB0 25
#define RB1 26
#define RB2 27
#define RB3 28
#define RB4 29

// Outer pinkies on the bottom row
#define LB5 30
#define RB5 37

// Thumb cluster
#define LH2 31
#define LH1 32
#define LH0 33
#define RH0 34
#define RH1 35
#define RH2 36

/* ------------------------------- aliases ------------------------------- */

#define XXX &none
#define ___ &trans

// Layer indices
#define BASE 0
#define NAV  1
#define NUM  2
#define FUN  3
#define UTIL 4

// Navigation: back/forward / prev-tab/next-tab (macOS bindings)
#define BACK &kp LG(LBKT)
#define FWD  &kp LG(RBKT)

// Hyper and Meh
#define HYP LS(LC(LA(LGUI)))
#define MEH LS(LC(LALT))

/* ----------------------------- tuning knobs ---------------------------- */

#define QUICK_TAP_MS 175

&caps_word {
    /delete-property/ ignore-numbers;
    continue-list = <BACKSPACE ENTER DELETE UNDERSCORE MINUS>;
};

&key_repeat {
    usage-pages = <HID_USAGE_KEY HID_USAGE_CONSUMER>;
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};

/* ---------------------------- home-row mods ---------------------------- */

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_BEHAVIOR(NAME, hold_tap, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )
MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)
MAKE_HRM(hmr_meh, &kp, &comma_morph, KEYS_L THUMBS)

/* ---------------------------- mod-morphs ----------------------------- */

ZMK_BEHAVIOR(comma_morph, mod_morph,
    bindings = <&kp COMMA>, <&kp SEMICOLON>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

ZMK_BEHAVIOR(dot_morph, mod_morph,
    bindings = <&kp DOT>, <&kp COLON>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

/* -------------------------------- combos ------------------------------- */

#include "combos.dtsi"

/* ------------------------------- layers -------------------------------- */
/*
 * Bindings are listed in matrix-transform position order (row-major):
 *   row 0: top row (10)
 *   row 1: home row (10)
 *   row 2: inner bottom row (10)
 *   row 3: outer pinky L (1) | left thumbs (3) | right thumbs (3) | outer pinky R (1)
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
        &kp Q         &kp W       &kp E         &kp R          &kp T           &kp Y      &kp U          &kp I         &kp O       &kp P
        &hml LCTRL A  &hml LALT S &hml LGUI D   &hml LSHFT F   &kp G           &kp H      &hmr RSHFT J   &hmr RGUI K   &hmr LALT L &hmr RCTRL SEMI
        &kp Z         &kp X       &hml MEH C    &hml HYP V     &kp B           &kp N      &hmr HYP M     &hmr_meh MEH 0 &dot_morph &kp FSLH
        &kp TAB             &lt UTIL ESC  &lt NAV SPACE  &sk LSHFT       &kp RET    &lt NUM BSPC   &lt FUN DEL              &kp TAB
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
        ___          ___         ___          ___           ___                ___        &kp HOME      &kp UP        &kp END     &kp PAGE_UP
        &kp LCTRL    &kp LALT    &kp LGUI     &kp LSHFT     ___                ___        &kp LEFT      &kp DOWN      &kp RIGHT   &kp PAGE_DOWN
        ___          ___         &kp MEH      &kp HYP       ___                ___        &kp TILDE     ___           &kp FSLH    ___
        BACK                ___          ___           ___             &kp RET    &kp BSPC      &kp DEL                  FWD
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
        &kp PLUS     &kp N7      &kp N8       &kp N9        &kp STAR           ___        ___           ___           ___         ___
        &kp N0       &kp N4      &kp N5       &kp N6        &kp EQUAL          ___        &kp LSHFT     &kp LGUI      &kp LALT    &kp LCTRL
        &kp MINUS    &kp N1      &kp N2       &kp N3        &kp FSLH           ___        &kp HYP       &kp MEH       ___         ___
        &kp LPAR            ___          &kp DOT       &kp SEMI           ___        ___           ___                  &kp RPAR
            >;
        };

        fun_layer {
            display-name = "FUN";
            bindings = <
        &kp F12      &kp F7      &kp F8       &kp F9        ___                ___        ___           ___           ___         ___
        &kp F11      &kp F4      &kp F5       &kp F6        ___                ___        &kp LSHFT     &kp LGUI      &kp LALT    &kp LCTRL
        &kp F10      &kp F1      &kp F2       &kp F3        ___                ___        &kp HYP       &kp MEH       ___         ___
        ___                 ___          ___           ___                ___        ___           ___                      ___
            >;
        };

        util_layer {
            display-name = "UTIL";
            bindings = <
        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR    ___                ___        ___           &kp C_VOL_UP  ___         ___
        &kp LCTRL    &kp LALT    &kp LGUI     &kp LSHFT     ___                ___        ___           &kp C_VOL_DN  ___         ___
        ___          ___         ___          &kp HYP       ___                ___        ___           ___           ___         ___
        ___                 ___          ___           ___                ___        ___           &kp C_MUTE               ___
            >;
        };
    };
};
        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR    ___                ___        ___           &kp C_VOL_UP  ___         ___
        &kp LCTRL    &kp LALT    &kp LGUI     &kp LSHFT     ___                ___        ___           &kp C_VOL_DN  ___         ___
        ___          ___         ___          &kp HYP       ___                ___        ___           ___           ___         ___
        ___                 ___          ___           ___                ___        ___           &kp C_MUTE               ___
            >;
        };
    };
};
        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR    ___                ___        ___           &kp C_VOL_UP  ___         ___
        &kp LCTRL    &kp LALT    &kp LGUI     &kp LSHFT     ___                ___        ___           &kp C_VOL_DN  ___         ___
        ___          ___         ___          &kp HYP       ___                ___        ___           ___           ___         ___
        ___                 ___          ___           ___                ___        ___           &kp C_MUTE               ___
            >;
        };
    };
};
